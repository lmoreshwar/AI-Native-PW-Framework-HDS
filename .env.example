# ═══════════════════════════════════════════════
# Playwright AI Automation Framework — Environment Template
# ═══════════════════════════════════════════════

APP_BASE_URL=https://app.example.com
TEST_ENV=qa
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=90000
LOG_LEVEL=INFO
RETRY_COUNT=2

# Sauce Labs Toggle (true = run on cloud, false = run locally)
RUN_ON_SAUCE=false

# Application Credentials (local dev only; CI pulls from GitHub repository secrets)
APP_USERNAME=your-app-username
APP_PASSWORD=your-app-password

# Optional profile switch within same env file: default | ftr | dpr
APP_PROFILE=default

# FTR Profile
FTR_BASE_URL=
FTR_APP_USERNAME=
FTR_APP_PASSWORD=

# DPR Profile
DPR_BASE_URL=
DPR_APP_USERNAME=
DPR_APP_PASSWORD=

# PQR Profiles (Non-CQS, CQS PE, TCI Port Engineer roles)
PQR_BASE_URL=
PQR_APP_USERNAME=
PQR_APP_PASSWORD=
PQR_CQS_APP_USERNAME=
PQR_CQS_APP_PASSWORD=
PQR_TCI_APP_USERNAME=
PQR_TCI_APP_PASSWORD=

# Sauce Labs Credentials / Endpoint
SAUCE_USERNAME=your-sauce-username
SAUCE_ACCESS_KEY=your-sauce-access-key
SAUCE_URL=@ondemand.<region>.saucelabs.com:443/wd/hub
